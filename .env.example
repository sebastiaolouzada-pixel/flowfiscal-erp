# ==========================================
# CONFIGURAÇÕES DO FLOWFISCAL ERP
# ==========================================

# DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/flowfiscal
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=flowfiscal_user
DATABASE_PASSWORD=secure_password_here
DATABASE_NAME=flowfiscal

# BACKEND
BACKEND_URL=http://localhost:8000
BACKEND_PORT=8000
ENVIRONMENT=development

# FRONTEND
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

# EMAIL (opcional - para notificações)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_app

# AWS S3 (opcional - para armazenamento de documentos)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=flowfiscal-docs
AWS_REGION=us-east-1

# LOGGING
LOG_LEVEL=INFO
LOG_FORMAT=json

# SECURITY
ALLOWED_FILE_EXTENSIONS=pdf,xml,xlsx,xls
MAX_FILE_SIZE_MB=50
